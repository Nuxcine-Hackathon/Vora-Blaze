# Copiez ce fichier en .env et remplissez avec vos vraies valeurs (jamais commité)

PORT=4000
NODE_ENV=development

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Auth
JWT_SECRET=un_secret_long_et_aleatoire
JWT_EXPIRES_IN=7d

# Assistant IA (Franck) — laissez vide si le vrai service n'est pas encore branché,
# le mode "mock" par mots-clés sera utilisé automatiquement.
ASSISTANT_MODE=mock
ASSISTANT_API_URL=
ASSISTANT_API_KEY=

# CORS — URL(s) autorisée(s) côté frontend (Socrate), séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
