APP_NAME=OnTravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_INSTALL=true
APP_LOG_LEVEL=debug
APP_MODE=live
APP_URL=http://127.0.0.1:8000

# Optional — defaults to APP_URL if not set. Used by the admin panel's
# "visit landing page" link.
LANDING_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ontravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

PURCHASE_CODE=

# Shared secret the mobile apps send to /generateToken before minting a
# Sanctum bearer token — must match Config.secretKey in each Flutter app's
# lib/core/services/config.dart. Generate your own random string; never
# reuse the vendor-shipped default in a real deployment.
APP_SHARED_SECRET=

# Google AI Studio API key for the in-app assistant (free tier, no card
# required): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Mobile Money payment gateway (PayDunya). Leave PAYDUNYA_MODE=demo to run
# the full payment flow with no real transaction and no merchant account —
# this is what the hackathon demo uses. Set to "sandbox" or "live" with
# real credentials from your PayDunya merchant dashboard to process real
# MTN/Orange Money payments.
PAYDUNYA_MODE=demo
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
